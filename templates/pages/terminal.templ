	<div class="out-grid">
		<span class="cmd">email</span><span><a href="mailto:mwangikabiru21@gmail.com">mwangikabiru21@gmail.com</a></span>
		<span class="cmd">github</span><span><a href="https://github.com/BrianMwangi21" target="_blank" rel="noopener noreferrer">github.com/BrianMwangi21</a></span>
		<span class="cmd">linkedin</span><span><a href="https://www.linkedin.com/in/brian-mwangi/" target="_blank" rel="noopener noreferrer">linkedin.com/in/brian-mwangi</a></span>
		<span class="cmd">substack</span><span><a href="https://wordsbykabiru.substack.com/" target="_blank" rel="noopener noreferrer">wordsbykabiru.substack.com</a></span>
