// ==================== ls ====================

templ LsOutput() {
	<pre class="man">total 6
drwxr-xr-x  ventures/      <span class="dim">→ thinkstack</span>
drwxr-xr-x  projects/      <span class="dim">→ ls projects</span>
-rw-r--r--  about.txt      <span class="dim">→ cat about.txt</span>
-rw-r--r--  career.log     <span class="dim">→ cat career.log</span>
-rw-r--r--  skills.txt     <span class="dim">→ cat skills.txt</span>
-rw-r--r--  contact.txt    <span class="dim">→ cat contact.txt</span>
-r--r--r--  quotes.db      <span class="dim">→ fortune</span></pre>
}

// ==================== paige denial ====================

templ PaigeDeniedOutput() {
	<p><span class="err">cat: paige/: permission denied</span></p>
	<p>some directories aren't yours to read. 🔒</p>
	<p class="dim">({ "if" } you know, you know → <a href="/paige">/paige</a>)</p>
}

// ==================== command not found ====================

templ NotFoundOutput(cmd string) {
	<p><span class="err">bash: { cmd }: command not found</span> <span class="dim">— type <code>help</code></span></p>
}
