package pages

templ MetaTags(keywords, description string) {
	<meta name="keywords" content={ keywords }/>
	<meta name="description" content={ description }/>
}

templ TerminalContent() {
	<div id="app" class="term-shell" x-data="terminal()" @click="maybeFocus($event)">
		<div class="term-window">
			<div class="term-titlebar">
				<span class="term-dots" aria-hidden="true">
					<span class="term-dot dot-red"></span>
					<span class="term-dot dot-yellow"></span>
					<span class="term-dot dot-green"></span>
				</span>
				<span class="term-title">visitor&#64;mwangi.kabiru: ~</span>
				<span class="term-proto">ssh · htmx</span>
			</div>

			<div class="term-body">
				<div id="scrollback" x-ref="scrollback">
					<div class="boot" aria-hidden="true">
						<p class="boot-line">[<span class="ok">&nbsp;ok&nbsp;</span>] go 1.25 · fiber · templ · htmx — all systems nominal</p>
						<p class="boot-line">[<span class="ok">&nbsp;ok&nbsp;</span>] mounted /home/visitor</p>
					</div>

					@Result("whoami", WhoamiOutput())

					<p class="term-hint">
						type <code>help</code> { "for" } commands · <code>↑</code>/<code>↓</code> history · <code>tab</code> completes · <code>clear</code> wipes
					</p>
				</div>

				<div class="term-chips" aria-label="quick commands">
					<button type="button" @click="runCommand('help')">help</button>
					<button type="button" @click="runCommand('whoami')">whoami</button>
					<button type="button" @click="runCommand('thinkstack')">thinkstack</button>
					<button type="button" @click="runCommand('experience')">experience</button>
					<button type="button" @click="runCommand('projects')">projects</button>
					<button type="button" @click="runCommand('skills')">skills</button>
					<button type="button" @click="runCommand('fortune')">fortune</button>
					<button type="button" @click="runCommand('man kabiru')">man kabiru</button>
					<button type="button" @click="runCommand('contact')">contact</button>
					<button type="button" @click="runCommand('clear')">clear</button>
				</div>

				<form
					hx-post="/api/exec"
					hx-target="#scrollback"
					hx-swap="beforeend"
					x-ref="form"
					class="term-form"
					autocomplete="off"
				>
					@PromptLabel()
					<input
						x-ref="input"
						x-model="input"
						@keydown="onKeydown($event)"
						type="text"
						name="command"
						class="term-input"
						spellcheck="false"
						autocapitalize="off"
						autocomplete="off"
						aria-label="terminal input"
					/>
				</form>
			</div>
		</div>
	</div>
}
